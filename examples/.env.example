# Example schema — annotate each key with [type, optional]
APP_NAME=my-service                 # [optional] shown in logs
PORT=8000                           # [port] port the API listens on
DEBUG=false                         # [bool, optional]
DATABASE_URL=                       # [url] postgres://user:${DB_PASSWORD}@host/db
OPENAI_API_KEY=                     # get one at platform.openai.com
LOG_LEVEL=info                      # [choice=debug|info|warning|error, optional]
ADMIN_EMAIL=                        # [email, optional]
FEATURE_FLAGS={}                    # [json, optional]
